<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Questionnaires des biens — ALB Immobilier</title>
  <link rel="stylesheet" href="polices/polices.css">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="alb-connexion.js"></script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Montserrat', sans-serif; background: #F5F3F0; color: #4A4A47; line-height: 1.5; }
    h1, h2 { font-family: 'Playfair Display', serif; color: #5A3A6A; }
    .cache { display: none !important; }

    /* Bandeau (le même que Gestion du site) */
    .bandeau { background: #4B1A3E; color: #fff; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; position: sticky; top: 0; z-index: 100; }
    .bandeau-gauche { display: flex; align-items: center; gap: 10px; }
    .bandeau img { height: 38px; background: #fff; border-radius: 6px; padding: 3px 6px; }
    .bandeau-titre { font-weight: 700; font-size: 1rem; }
    .bandeau-droite { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px 8px; align-items: center; }
    .bandeau a { color: #fff; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25); border-radius: 6px; padding: 7px 10px; font-size: 0.8rem; text-decoration: none; }
    .bandeau a:hover { background: #B28E3D; border-color: #B28E3D; }

    .contenu { max-width: 800px; margin: 0 auto; padding: 20px 16px 60px; }
    .aide { font-size: 0.8rem; color: #7a7a75; margin: 4px 0 12px; }
    .message { padding: 12px 14px; border-radius: 6px; margin: 14px 0; font-size: 0.9rem; background: #F4EEF6; color: #5A3A6A; border: 1px solid #E2D6E8; }
    .message.erreur { background: #FBECEC; color: #8A2D2D; border-color: #F0CACA; }
    .message.succes { background: #EEF6EE; color: #2E6B34; border-color: #CFE4CF; }

    /* Chiffres */
    .compteurs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 14px 0; }
    .compteur { background: #fff; border: 1px solid #E8E6E1; border-radius: 10px; padding: 12px; }
    .compteur .valeur { font-size: 1.6rem; font-weight: 700; color: #5A3A6A; line-height: 1.1; }
    .compteur .libelle { font-size: 0.8rem; margin-top: 4px; }
    .compteur.or { border-color: #B28E3D; background: #FBF3E4; }
    .compteur.or .valeur { color: #8A6A1F; }

    /* Filtres */
    .ligne-filtres { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 10px; }
    .filtre { border: 1px solid #E8E6E1; background: #fff; color: #4A4A47; border-radius: 16px; padding: 7px 14px; font-family: inherit; font-size: 0.84rem; font-weight: 600; cursor: pointer; }
    .filtre.actif { background: #5A3A6A; border-color: #5A3A6A; color: #fff; }

    /* Fiches */
    .contact { background: #fff; border: 1px solid #E8E6E1; border-radius: 10px; padding: 14px; margin-bottom: 12px; }
    .contact.rappele { background: #F7F7F4; }
    .contact-tete { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; flex-wrap: wrap; }
    .contact-nom { font-weight: 700; font-size: 1.02rem; color: #4B1A3E; word-break: break-word; }
    .contact-metier { font-size: 0.88rem; color: #7a7a75; }
    .contact-coordonnees { margin: 10px 0; font-size: 0.95rem; font-weight: 600; word-break: break-word; }
    .contact-date { font-size: 0.76rem; color: #7a7a75; margin-top: 2px; }
    .badge { display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 3px 9px; border-radius: 10px; margin-left: 4px; }
    .badge-alerte { background: #FBECEC; color: #8A2D2D; border: 1px solid #F0CACA; }
    .badge-proche { background: #FBF3E4; color: #8A6A1F; border: 1px solid #B28E3D; }
    .badge-fait { background: #EEF6EE; color: #2E6B34; }
    .contact-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .bouton-petit { font-family: inherit; font-size: 0.84rem; font-weight: 600; padding: 9px 14px; border-radius: 8px; border: 1px solid #5A3A6A; background: #5A3A6A; color: #fff; cursor: pointer; text-decoration: none; display: inline-block; }
    .bouton-petit.clair { background: #fff; color: #5A3A6A; }
    .bouton-petit.or { background: #B28E3D; border-color: #B28E3D; }
    .bouton-petit:disabled { opacity: 0.6; cursor: wait; }
    .contact textarea { width: 100%; margin-top: 10px; padding: 9px; font-family: inherit; font-size: 0.88rem; border: 1px solid #E8E6E1; border-radius: 8px; min-height: 56px; resize: vertical; }
    .vide { text-align: center; padding: 24px 10px; color: #7a7a75; font-size: 0.92rem; background: #fff; border-radius: 10px; border: 1px solid #E8E6E1; }

    /* Détail des réponses */
    .detail { margin-top: 12px; padding: 12px; background: #FBF8F3; border: 1px solid #E8E6E1; border-radius: 10px; }
    .detail-titre { font-weight: 700; color: #4B1A3E; margin: 10px 0 4px; font-size: 0.9rem; }
    .detail-titre:first-child { margin-top: 0; }
    .detail-ligne { display: flex; gap: 8px; font-size: 0.85rem; padding: 3px 0; border-bottom: 1px dashed #E8E6E1; }
    .detail-cle { flex: 0 0 42%; color: #7a7a75; font-weight: 600; }
    .detail-val { flex: 1; word-break: break-word; }
  </style>
</head>
<body>

<header class="bandeau">
  <div class="bandeau-gauche">
    <img src="logo-signature.png" alt="ALB Sud Immobilier">
    <span class="bandeau-titre">Questionnaires des biens</span>
  </div>
  <div class="bandeau-droite">
    <a href="gestion-site.html">← Gestion du site</a>
    <a href="calendrier.html">📅 Calendrier</a>
    <a href="questionnaires.html">📝 Questionnaires</a>
    <a href="contacts-salon.html">📇 Contacts du salon</a>
    <a href="statistiques.html">📈 Statistiques</a>
    <a href="index.html" target="_blank">Voir le site</a>
  </div>
</header>

<main class="contenu">
  <div id="etat" class="message">Chargement des questionnaires…</div>

  <div id="page" class="cache">
    <h1>🏠 Questionnaires des biens</h1>
    <p class="aide">Les questionnaires envoyés par les agents et mandataires depuis leur espace. Appuie sur « J'ai traité » quand tu as repris contact avec le pro (pour lui proposer la description de l'annonce, par exemple). Les fins de mandat les plus proches sont en haut de la liste « À traiter ».</p>

    <div class="compteurs" id="compteurs"></div>
    <div class="ligne-filtres" id="filtres"></div>
    <div id="liste"></div>
  </div>
</main>

<script>
  // ============================================================
  // Questionnaires des biens : réservé à Jocelyne (même accès que Gestion du site)
  // La liste vient d'une fonction Supabase qui vérifie que tu es bien admin.
  // ============================================================
  const FILTRES_ETAT = [['atraiter', 'À traiter'], ['traites', 'Traités'], ['tous', 'Tous']];
  const TYPES_BIEN = { appartement: '🏢 Appartement', maison: '🏡 Maison', village: '🏘️ Maison de village' };
  const JOURS_ALERTE = 60; // une fin de mandat à moins de 60 jours est signalée

  const choix = { etat: 'atraiter', seulementProches: false };
  let questionnaires = [];

  const ouverts = {};        // id du questionnaire -> true si le détail est déplié
  const notesEnCours = {};   // notes tapées mais pas encore enregistrées

  function e(texte) { return albEchapper(texte); }
  function el(id) { return document.getElementById(id); }

  // Date et heure en français, par exemple « 20 novembre, 18:14 »
  function formatDateFr(iso) {
    return new Date(iso).toLocaleString('fr-FR', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
  }

  // Date seule en français (la fin de mandat n'a pas d'heure), par exemple « 3 mars 2027 »
  function formatJourFr(jour) {
    return new Date(jour + 'T12:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  // Nombre de jours avant la fin du mandat (négatif si elle est dépassée, null si pas de date)
  function joursAvantFin(fin) {
    if (!fin) { return null; }
    const jourFin = new Date(fin + 'T12:00:00');
    const aujourdhui = new Date();
    aujourdhui.setHours(12, 0, 0, 0);
    return Math.round((jourFin - aujourdhui) / 86400000);
  }

  function finProche(q) {
    const jours = joursAvantFin(q.fin_mandat);
    return jours !== null && jours <= JOURS_ALERTE;
  }

  // Repère coloré selon l'approche de la fin du mandat
  function badgeMandat(q) {
    const jours = joursAvantFin(q.fin_mandat);
    if (jours === null) { return ''; }
    if (jours < 0) { return '<span class="badge badge-alerte">⚠️ Mandat terminé depuis ' + (-jours) + ' j</span>'; }
    if (jours <= JOURS_ALERTE) { return '<span class="badge badge-proche">⏰ Fin de mandat dans ' + jours + ' j</span>'; }
    return '';
  }

  function telephonePropre(texte) { return String(texte || '').replace(/[^\d+]/g, ''); }

  // Retient les notes déjà tapées, pour ne pas les perdre quand la liste se redessine
  function memoriserNotes() {
    questionnaires.forEach(function (q) {
      const zone = document.getElementById('note-' + q.id);
      if (zone) { notesEnCours[q.id] = zone.value; }
    });
  }

  // Applique les filtres, puis trie : fins de mandat les plus proches d'abord (à traiter), sinon les plus récents
  function questionnairesAffiches() {
    const liste = questionnaires.filter(function (q) {
      const bonEtat = choix.etat === 'tous' || (choix.etat === 'atraiter' ? !q.traite_le : !!q.traite_le);
      const bonMandat = !choix.seulementProches || finProche(q);
      return bonEtat && bonMandat;
    });
    liste.sort(function (a, b) {
      if (choix.etat === 'atraiter' || choix.seulementProches) {
        if (a.fin_mandat && b.fin_mandat && a.fin_mandat !== b.fin_mandat) { return a.fin_mandat < b.fin_mandat ? -1 : 1; }
        if (a.fin_mandat && !b.fin_mandat) { return -1; }
        if (!a.fin_mandat && b.fin_mandat) { return 1; }
      }
      return new Date(b.envoye_le) - new Date(a.envoye_le);
    });
    return liste;
  }

  function dessinerCompteurs() {
    const aTraiter = questionnaires.filter(function (q) { return !q.traite_le; });
    const proches = questionnaires.filter(finProche);
    el('compteurs').innerHTML =
      '<div class="compteur or"><div class="valeur">' + aTraiter.length + '</div><div class="libelle">À traiter</div></div>' +
      '<div class="compteur or"><div class="valeur">' + proches.length + '</div><div class="libelle">Fins de mandat proches (moins de ' + JOURS_ALERTE + ' jours ou dépassées)</div></div>' +
      '<div class="compteur"><div class="valeur">' + (questionnaires.length - aTraiter.length) + '</div><div class="libelle">Déjà traités</div></div>' +
      '<div class="compteur"><div class="valeur">' + questionnaires.length + '</div><div class="libelle">Questionnaires au total</div></div>';
  }

  function dessinerFiltres() {
    el('filtres').innerHTML = FILTRES_ETAT.map(function (f) {
      return '<button type="button" class="filtre' + (choix.etat === f[0] ? ' actif' : '') + '" data-etat="' + f[0] + '">' + e(f[1]) + '</button>';
    }).join('') +
      '<button type="button" class="filtre' + (choix.seulementProches ? ' actif' : '') + '" data-proches="1">⏰ Fin de mandat proche</button>' +
      '<button type="button" class="filtre" data-actualiser="1">🔄 Actualiser</button>';
  }

  // ----- Détail des réponses -----
  // Les réponses sont rangées sous forme de libellés lisibles (par section) : on les affiche telles quelles.
  function valeurLisible(valeur) {
    if (valeur === true) { return 'Oui'; }
    if (valeur === false) { return 'Non'; }
    if (Array.isArray(valeur)) {
      return valeur.map(function (v) {
        return (v && typeof v === 'object') ? Object.keys(v).filter(function (k) { return v[k] !== '' && v[k] !== null; }).map(function (k) { return k + ' : ' + valeurLisible(v[k]); }).join(' · ') : valeurLisible(v);
      }).filter(function (t) { return t !== ''; }).join(' | ');
    }
    if (valeur === null || valeur === undefined) { return ''; }
    return String(valeur);
  }

  function detailHtml(objet) {
    let html = '';
    Object.keys(objet || {}).forEach(function (cle) {
      const valeur = objet[cle];
      if (valeur && typeof valeur === 'object' && !Array.isArray(valeur)) {
        const interieur = detailHtml(valeur);
        if (interieur) { html += '<div class="detail-titre">' + e(cle) + '</div>' + interieur; }
        return;
      }
      const texte = valeurLisible(valeur);
      if (texte === '') { return; }
      html += '<div class="detail-ligne"><span class="detail-cle">' + e(cle) + '</span><span class="detail-val">' + e(texte) + '</span></div>';
    });
    return html;
  }

  function blocDetail(q) {
    if (!ouverts[q.id]) { return ''; }
    const contenu = detailHtml(q.reponses);
    return '<div class="detail">' + (contenu || '<p class="aide">Aucune réponse remplie pour le moment.</p>') + '</div>';
  }

  function dessinerFiche(q) {
    const traite = !!q.traite_le;
    const noteTexte = (notesEnCours[q.id] !== undefined) ? notesEnCours[q.id] : (q.note || '');
    const nomPro = [q.pro_prenom, q.pro_nom].filter(Boolean).join(' ') || q.pro || 'Pro';
    const tel = telephonePropre(q.pro_telephone);

    let actionsContact = '';
    if (tel) { actionsContact += '<a class="bouton-petit clair" href="tel:' + e(tel) + '">📞 Appeler</a>'; }
    if (q.pro_email) {
      const sujet = 'Votre annonce' + (q.adresse ? ' — ' + q.adresse : '');
      actionsContact += '<a class="bouton-petit clair" href="mailto:' + e(q.pro_email) + '?subject=' + encodeURIComponent(sujet) + '">✉️ Écrire</a>';
      actionsContact += '<button type="button" class="bouton-petit clair" data-action="copier-email" data-email="' + e(q.pro_email) + '">📋 Copier l\'e-mail</button>';
    }

    const boutonEtat = traite
      ? '<button type="button" class="bouton-petit clair" data-action="remettre" data-id="' + e(q.id) + '">↩️ Remettre à traiter</button>'
      : '<button type="button" class="bouton-petit or" data-action="traite" data-id="' + e(q.id) + '">✅ J\'ai traité</button>';

    return '<div class="contact' + (traite ? ' rappele' : '') + '">' +
      '<div class="contact-tete"><div>' +
        '<div class="contact-nom">' + e(TYPES_BIEN[q.type_bien] || q.type_bien) + ' · ' + e(q.adresse || 'Adresse non indiquée') + '</div>' +
        '<div class="contact-metier">' + e(nomPro) + (q.pro_entreprise ? ' · ' + e(q.pro_entreprise) : '') + '</div>' +
      '</div><div>' + badgeMandat(q) + (traite ? '<span class="badge badge-fait">Traité</span>' : '') + '</div></div>' +
      '<div class="contact-coordonnees">' + e(q.pro_email || 'E-mail non renseigné') + (q.pro_telephone ? ' · ' + e(q.pro_telephone) : '') + '</div>' +
      '<div class="contact-date">Envoyé le ' + e(formatDateFr(q.envoye_le)) +
        (q.fin_mandat ? ' · fin de mandat le ' + e(formatJourFr(q.fin_mandat)) : ' · pas de date de fin de mandat') +
        (traite ? ' · traité le ' + e(formatDateFr(q.traite_le)) : '') + '</div>' +
      '<div class="contact-actions">' + actionsContact +
        '<button type="button" class="bouton-petit clair" data-action="detail" data-id="' + e(q.id) + '">' + (ouverts[q.id] ? '▲ Masquer le détail' : '▼ Voir le détail') + '</button></div>' +
      blocDetail(q) +
      '<textarea id="note-' + e(q.id) + '" placeholder="Une note pour toi (ce qu\'on s\'est dit, ce qu\'il reste à faire…)">' + e(noteTexte) + '</textarea>' +
      '<div class="contact-actions">' + boutonEtat +
        '<button type="button" class="bouton-petit clair" data-action="note" data-id="' + e(q.id) + '">💾 Enregistrer la note</button></div>' +
    '</div>';
  }

  function dessinerListe() {
    memoriserNotes();
    const liste = questionnairesAffiches();
    if (!liste.length) {
      el('liste').innerHTML = '<div class="vide">' + (choix.etat === 'atraiter' && !choix.seulementProches ? 'Aucun questionnaire à traiter pour le moment. 🌿' : 'Aucun questionnaire ici pour le moment.') + '</div>';
      return;
    }
    el('liste').innerHTML = liste.map(dessinerFiche).join('');
  }

  function dessinerTout() {
    dessinerCompteurs();
    dessinerFiltres();
    dessinerListe();
  }

  // Récupère la liste depuis Supabase
  async function chargerQuestionnaires() {
    const { data, error } = await albSupabase.rpc('alb_gestion_questionnaires_biens');
    if (error) {
      console.log('[ALB DEBUG] questionnaires des biens : chargement impossible', error);
      el('etat').className = 'message erreur';
      el('etat').textContent = 'La liste n\'a pas pu être chargée. Recharge la page dans un instant.';
      el('etat').classList.remove('cache');
      return false;
    }
    questionnaires = data || [];
    return true;
  }

  // Marque un questionnaire comme traité (ou à traiter), et enregistre la note
  async function marquerQuestionnaire(id, traite, note) {
    const { error } = await albSupabase.rpc('alb_gestion_questionnaire_bien_traite', { p_id: id, p_traite: traite, p_note: note });
    if (error) {
      console.log('[ALB DEBUG] questionnaires des biens : mise à jour impossible', error);
      el('etat').className = 'message erreur';
      el('etat').textContent = 'Le changement n\'a pas été enregistré. Réessaie dans un instant.';
      el('etat').classList.remove('cache');
      return;
    }
    el('etat').classList.add('cache');
    delete notesEnCours[id];
    if (await chargerQuestionnaires()) { dessinerTout(); }
  }

  // Copie une adresse e-mail
  async function copierEmail(email, bouton) {
    try { await navigator.clipboard.writeText(email); } catch (erreur) { console.log('[ALB DEBUG] copie impossible', erreur); return; }
    const avant = bouton.textContent;
    bouton.textContent = '✓ Copié';
    setTimeout(function () { bouton.textContent = avant; }, 1500);
  }

  document.addEventListener('click', async function (evenement) {
    const bouton = evenement.target.closest('button');
    if (!bouton) { return; }

    if (bouton.dataset.etat) { choix.etat = bouton.dataset.etat; dessinerTout(); return; }
    if (bouton.dataset.proches) { choix.seulementProches = !choix.seulementProches; dessinerTout(); return; }
    if (bouton.dataset.actualiser) { memoriserNotes(); if (await chargerQuestionnaires()) { dessinerTout(); } return; }

    if (bouton.dataset.action === 'copier-email') { await copierEmail(bouton.dataset.email, bouton); return; }

    const id = bouton.dataset.id;
    if (!id) { return; }

    if (bouton.dataset.action === 'detail') { ouverts[id] = !ouverts[id]; dessinerListe(); return; }

    const zoneNote = document.getElementById('note-' + id);
    const note = zoneNote ? zoneNote.value : null;
    const questionnaire = questionnaires.find(function (q) { return q.id === id; });

    if (bouton.dataset.action === 'traite') { await marquerQuestionnaire(id, true, note); }
    if (bouton.dataset.action === 'remettre') { await marquerQuestionnaire(id, false, note); }
    if (bouton.dataset.action === 'note') { await marquerQuestionnaire(id, !!(questionnaire && questionnaire.traite_le), note); }
  });

  async function demarrer() {
    const etat = el('etat');
    const { data: session } = await albSupabase.auth.getSession();
    if (!session?.session) {
      etat.innerHTML = 'Connecte-toi d\'abord dans <a href="gestion-site.html">Gestion du site</a>, puis reviens ici.';
      return;
    }
    const { data: estAdmin } = await albSupabase.rpc('alb_est_admin');
    if (estAdmin !== true) {
      etat.className = 'message erreur';
      etat.textContent = 'Cette page est réservée à l\'équipe ALB Sud Immobilier.';
      return;
    }
    if (!(await chargerQuestionnaires())) { return; }
    etat.classList.add('cache');
    el('page').classList.remove('cache');
    dessinerTout();
  }

  document.addEventListener('DOMContentLoaded', demarrer);
</script>
</body>
</html>
